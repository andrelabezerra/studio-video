    {
      "id": "editorial_motion",
      "label": "Editorial Motion · Palco Cinematográfico",
      "tier": 1,
      "default_cost_usd": 0.0,
      "description": "Palco livre multi-beats (4s–9s) com 8 composições SVG coreografadas (balança de dívida, cancelamento com tinta viva, split-screen dramático, pergunta retórica, iluminação de graça, arco narrativo, contador monumental e citação bíblica limpa).",

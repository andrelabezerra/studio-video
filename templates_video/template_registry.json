        "mapa_contexto",
        "perdido_traducao",
        "mito_vs_texto",
        "conexao_at_nt"
      ],
      "compositions": [
        "auto",
        "debt_scale",
        "forgiveness_seal",
        "dramatic_split",
        "rhetorical_question",
        "grace_illumination",
        "narrative_arc",
        "counter_impact",
        "scripture_spotlight"
      ],

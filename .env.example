# ==============================================================================
# Studio Video — Configuração Local (copie para .env e preencha apenas o que usar)
# NUNCA versione o arquivo .env no Git.
# ==============================================================================

# Servidor local da UI (estilo Neo Stitch) e API FastAPI
STUDIO_HOST=127.0.0.1
STUDIO_PORT=8740

# CRÍTICO NO WINDOWS: mantenha cache, frames e renders FORA do OneDrive
STUDIO_CACHE_DIR=%LOCALAPPDATA%\StudioVideo\cache

# Preset editorial padrão e tradução bíblica de referência
STUDIO_DEFAULT_PRESET=pastor-andre-biblico
DEFAULT_BIBLE_TRANSLATION=NVI

# ------------------------------------------------------------------------------
# Camada de Áudio (100% local e gratuita por padrão)
# Modos suportados: recorded | xtts_v2 | f5_tts | voicestudio
# ------------------------------------------------------------------------------
TTS_PROVIDER=recorded
TTS_VOICE_SAMPLE=assets/voice_samples/pastor_andre.wav
TTS_VENV_PYTHON=
VOICESTUDIO_URL=http://127.0.0.1:7860
ALIGNMENT_ENGINE=whisperx
WHISPER_MODEL=medium
WHISPER_DEVICE=auto

# ------------------------------------------------------------------------------
# Camada de Imagens e Vídeo (Estratégia Custo-Mínimo Primeiro)
# ------------------------------------------------------------------------------
# Padrão de imagens: gemini_hybrid (Prompt Pack + dropzone Gemini PRO Web) ou gemini_api
IMAGE_PROVIDER=gemini_hybrid
GEMINI_API_KEY=

# Opcional: fallback de imagem (ex: GPT Image 2) ou vídeo Nível 2 (Hailuo 3 / Grok)
OPENROUTER_API_KEY=

# Opcional: desativado no MVP; usado apenas para cenas que pedirem imagem -> 3D
FAL_KEY=

# ------------------------------------------------------------------------------
# Governança de Custos (USD) — trava operações pagas acima do teto sem aprovação
# ------------------------------------------------------------------------------
MAX_COST_PER_SCENE_USD=0.50
MAX_COST_PER_VIDEO_USD=2.50
ENABLE_TIER2_VIDEO=false
ENABLE_FAL_3D=false
